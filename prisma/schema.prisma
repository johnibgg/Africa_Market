// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  BUYER
  SELLER
  DELIVERY
  ADMIN
}

enum VerificationStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum ListingType {
  PRODUCT
  SERVICE
}

enum AdType {
  OFFER
  WANTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum NotificationType {
  NEW_LISTING
  NEW_MESSAGE
  ORDER_UPDATE
  NEW_FOLLOWER
  SYSTEM
}

model User {
  id                 String             @id @default(cuid())
  name               String?
  email              String?            @unique
  emailVerified      DateTime?
  password           String?
  image              String?
  role               UserRole           @default(BUYER)
  location           String?
  quartier           String?
  phone              String?
  bio                String?
  isVerified         Boolean            @default(false)
  verificationStatus VerificationStatus @default(NONE)
  shopName           String?
  shopDescription    String?
  joinedAt           DateTime           @default(now())

  // Relationships
  listings           Listing[]
  ordersAsBuyer      Order[]            @relation("BuyerOrders")
  ordersAsSeller     Order[]            @relation("SellerOrders")
  sentMessages       Message[]          @relation("SentMessages")
  receivedMessages   Message[]          @relation("ReceivedMessages")
  notifications      Notification[]
  
  // Following system
  followers          Follower[]         @relation("SellerFollowers")
  following          Follower[]         @relation("UserFollowing")

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Category {
  id         String    @id @default(cuid())
  name       String
  nameFr     String
  slug       String    @unique
  icon       String?
  isApproved Boolean   @default(true)
  listings   Listing[]
}

model Listing {
  id               String      @id @default(cuid())
  title            String
  description      String
  type             ListingType @default(PRODUCT)
  price            Float
  currency         String      @default("FCFA")
  images           String[]
  videoUrls        String[]    @default([])
  adType           AdType      @default(OFFER)
  location         String
  quartier         String?
  rating           Float       @default(0)
  reviewCount      Int         @default(0)
  views            Int         @default(0)
  isPromoted       Boolean     @default(false)
  status           String      @default("active")
  deliveryAvailable Boolean     @default(true)
  condition        String?     // "new", "used", etc.
  availability     String?     // for services

  category         Category    @relation(fields: [categoryId], references: [id])
  categoryId       String
  seller           User        @relation(fields: [sellerId], references: [id])
  sellerId         String

  reviews          Review[]
  orderItems       OrderItem[]
  
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  listing   Listing  @relation(fields: [listingId], references: [id])
  listingId String
  userId    String
  userName  String
  userAvatar String?
  
  createdAt DateTime @default(now())
}

model Order {
  id             String      @id @default(cuid())
  status         OrderStatus @default(PENDING)
  total          Float
  paymentMethod  String
  deliveryAddress String
  trackingNumber String?
  
  buyer          User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  buyerId        String
  seller         User        @relation("SellerOrders", fields: [sellerId], references: [id])
  sellerId       String
  
  items          OrderItem[]
  deliveryTask   DeliveryTask?
  
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int
  price     Float
  listing   Listing @relation(fields: [listingId], references: [id])
  listingId String
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   String
}

model DeliveryTask {
  id           String   @id @default(cuid())
  order        Order    @relation(fields: [orderId], references: [id])
  orderId      String   @unique
  pickupAddress String
  deliveryAddress String
  status       String   @default("pending")
  estimatedTime DateTime?
  fee          Float
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Message {
  id         String   @id @default(cuid())
  content    String
  isRead     Boolean  @default(false)
  
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  senderId   String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  receiverId String
  
  createdAt  DateTime @default(now())
}

model Follower {
  id         String   @id @default(cuid())
  
  seller     User     @relation("SellerFollowers", fields: [sellerId], references: [id])
  sellerId   String
  
  follower   User     @relation("UserFollowing", fields: [followerId], references: [id])
  followerId String

  createdAt  DateTime @default(now())

  @@unique([sellerId, followerId])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  content   String
  isRead    Boolean          @default(false)
  link      String?
  
  user      User             @relation(fields: [userId], references: [id])
  userId    String
  
  createdAt DateTime         @default(now())
}
